{
  "name": "buildwise-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter server test",
    "db:generate": "pnpm exec prisma generate",
    "db:validate": "pnpm exec prisma validate",
    "db:migrate": "pnpm exec prisma migrate deploy",
    "db:diff": "pnpm exec prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "prisma": "7.9.1",
    "typescript": "^5.7.3"
  }
}
