{
  "name": "buildwise-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm --filter client dev",
    "dev:client": "corepack pnpm --filter client dev",
    "dev:server": "corepack pnpm --filter server dev",
    "build": "corepack pnpm --filter client build && corepack pnpm --filter server build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm --filter server test",
    "db:generate": "corepack pnpm exec prisma generate",
    "db:validate": "corepack pnpm exec prisma validate",
    "db:migrate": "corepack pnpm exec prisma migrate deploy",
    "db:diff": "corepack pnpm exec prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "prisma": "7.9.1",
    "typescript": "^5.7.3"
  }
}
