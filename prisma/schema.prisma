// BuildWise AI baseline schema.
// Field set follows DATABASE.md. Nullable scores exist so missing provider
// data is stored as unavailable rather than imputed.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Site {
  id              String     @id @default(cuid())
  label           String?
  latitude        Float
  longitude       Float
  plotAreaSqFt    Float
  builtUpAreaSqFt Float
  buildingType    String
  floors          Int
  qualityGrade    String
  budget          Float?
  createdAt       DateTime   @default(now())
  analyses        Analysis[]

  @@index([latitude, longitude])
  @@index([createdAt])
}

model Analysis {
  id             String             @id @default(cuid())
  siteId         String
  site           Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  overallScore   Float?
  dataConfidence Float
  rawData        Json?
  normalizedData Json
  createdAt      DateTime           @default(now())
  factors        FactorResult[]
  orientation    OrientationResult?
  costEstimate   CostEstimate?
  reports        Report[]

  @@index([siteId])
  @@index([createdAt])
}

model FactorResult {
  id          String   @id @default(cuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  factor      String
  rawValue    String
  score       Float?
  weight      Float
  explanation String

  @@index([analysisId])
}

model OrientationResult {
  id               String   @id @default(cuid())
  analysisId       String   @unique
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  recommendedAngle Float
  solarScore       Float?
  windScore        Float?
  candidateScores  Json
}

model CostEstimate {
  id                String   @id @default(cuid())
  analysisId        String   @unique
  analysis          Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  area              Float
  baseRate          Float
  terrainMultiplier Float
  qualityMultiplier Float
  estimatedCost     Float
  rangeLow          Float
  rangeHigh         Float
}

model Report {
  id          String   @id @default(cuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  generatedAt DateTime @default(now())
  storagePath String?

  @@index([analysisId])
}

model ProviderCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  provider  String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([provider])
  @@index([expiresAt])
}
