# Copy to .env and fill in local values. Do not commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/buildwise
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/buildwise

HOST=0.0.0.0
PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API directly.
# Vite dev proxy does not need CORS. Leave empty to allow only non-browser clients.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OPEN_ELEVATION_BASE_URL=https://api.open-elevation.com/api/v1
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1

# Identify the application to OpenStreetMap. No credentials.
HTTP_USER_AGENT=BuildWiseAI/1.0 (construction pre-planning research)

PROVIDER_TIMEOUT_MS=12000
OVERPASS_TIMEOUT_MS=28000
REPORT_STORAGE_DIR=storage/reports
